PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/recruitment_db
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_min_32_chars_random_string
JWT_EXPIRES_IN=15m

# SMTP (for invite, candidate, and password-reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=Recruit360 <noreply@example.com>

# Initial Super Admin (run db:migrate once, then remove these)
INITIAL_ADMIN_EMAIL=admin@yourcompany.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Admin

# Interview scheduling reminders
REMINDER_MODE=PROD
REMINDER_FIRST_DELAY_MIN=1440
REMINDER_FINAL_DELAY_MIN=2160
SCHEDULE_EXPIRY_MIN=30
