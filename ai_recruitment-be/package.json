{
  "name": "recruitment-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "predev": "lsof -ti:3001 | xargs kill -9 2>/dev/null; exit 0",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && cp src/db/init.sql dist/db/init.sql && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "db:migrate": "ts-node src/db/migrate.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "uuid": "^8.3.2",
    "winston": "^3.13.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.41",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
